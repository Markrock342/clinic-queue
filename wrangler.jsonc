{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinic-queue",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "QUEUE", "class_name": "QueueStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueStore"] }],
  "observability": { "enabled": true }
}
